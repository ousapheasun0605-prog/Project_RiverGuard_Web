# RiverGuard settings. ./run.sh creates .env from this file with random secrets.

# Website port: http://localhost:8080
WEB_PORT=8080

# Database password (only used inside Docker)
POSTGRES_PASSWORD=change-me

# Login token secret (long random string)
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# First admin account, created on first start
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@riverguard.local
ADMIN_PASSWORD=change-me-12chars

# ---- Boat link (MQTT) ----
# The boat firmware (riverguard_boat_esp32/config.h) connects to MQTT_BROKER
# "tcp://broker.hivemq.com:1883". The website must use the SAME broker and topics.
#   Real boat:      MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
#   Simulated boat: ./run.sh --sim  (uses the local Mosquitto, ignores this line)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Must be unique on a public broker
MQTT_CLIENT_ID=riverguard-web-change-me

# firmware = real ESP32 text commands (stop, drive l r, go, rth ...) on <prefix>/cmd
#            and JSON telemetry on <prefix>/telemetry
# json     = older robot/1/* JSON protocol with acks
BOAT_PROTOCOL=firmware
# Must match TOPIC_TELE / TOPIC_CMD in the firmware config.h
BOAT_TOPIC_PREFIX=riverguard-itc

# Pi camera stream (MediaMTX, see pi/setup_camera.sh), e.g. http://192.168.1.50:8889/cam
CAMERA_URL=

TZ=Asia/Phnom_Penh
